{
  "version": 1,
  "meta": {
    "name": "Fixture Dark Cinematic",
    "slug": "fixture-dark-cinematic",
    "domain": "fixture-dark.example.com",
    "archetype": "cinematic",
    "colorScheme": "dark",
    "generator": "haazel@0.2.0"
  },
  "colors": {
    "palette": {
      "fairway": { "value": "#101F17", "role": "primary canvas", "maxShare": 0.78 },
      "gilt": { "value": "#C9A55C", "role": "accent, strokes and small fills only", "maxShare": 0.05 }
    },
    "semantic": {
      "dark": {
        "background": "#101F17",
        "foreground": "#F2EDE0",
        "card": "#172B1F",
        "cardForeground": "#F2EDE0",
        "popover": "#14261B",
        "popoverForeground": "#F2EDE0",
        "primary": "#C9A55C",
        "primaryForeground": "#14261B",
        "secondary": "#1C3326",
        "secondaryForeground": "#E4DCC6",
        "muted": "#14261B",
        "mutedForeground": "#A69E86",
        "accent": "#C9A55C",
        "accentForeground": "#14261B",
        "destructive": "#B3402E",
        "border": "#27402F",
        "input": "#27402F",
        "ring": "#C9A55C"
      }
    },
    "rules": ["Gilt never fills large blocks", "No gradients anywhere"]
  },
  "typography": {
    "fonts": {
      "display": {
        "family": "Fraunces",
        "provider": "google",
        "weights": [400, 500],
        "styles": ["normal", "italic"],
        "axes": { "opsz": [9, 144] },
        "fallback": "Georgia, serif"
      },
      "heading": {
        "family": "Cormorant Garamond",
        "provider": "google",
        "weights": [500, 600],
        "fallback": "Georgia, serif"
      },
      "body": {
        "family": "Inter Tight",
        "provider": "google",
        "weights": [400, 500],
        "fallback": "system-ui, sans-serif"
      },
      "mono": {
        "family": "JetBrains Mono",
        "provider": "google",
        "weights": [500],
        "fallback": "ui-monospace, monospace"
      }
    },
    "scale": {
      "hero": { "size": "clamp(4.5rem, 11vw, 12.5rem)", "lineHeight": 0.92, "font": "display", "weight": 500, "tracking": "-0.02em" },
      "display": { "size": "clamp(3rem, 6vw, 6.5rem)", "lineHeight": 0.98, "font": "display", "weight": 500 },
      "heading": { "size": "clamp(2rem, 4vw, 3.5rem)", "lineHeight": 1.05, "font": "heading", "weight": 500 },
      "subheading": { "size": "clamp(1.25rem, 2vw, 1.5rem)", "lineHeight": 1.3, "font": "heading", "weight": 500, "style": "italic" },
      "body": { "size": "1.0625rem", "lineHeight": 1.6, "font": "body", "weight": 400 },
      "caption": { "size": "0.8125rem", "lineHeight": 1.4, "font": "body", "weight": 500 },
      "overline": { "size": "0.6875rem", "lineHeight": 1.2, "font": "mono", "weight": 500, "tracking": "0.25em", "transform": "uppercase" }
    }
  },
  "shape": { "radius": "0px", "borderWidth": "1px" },
  "spacing": {
    "grid": 8,
    "sectionGap": "clamp(7.5rem, 16vw, 12.5rem)",
    "contentGap": "4rem",
    "elementGap": "1.25rem",
    "tightGap": "0.625rem",
    "containerMax": "75rem",
    "gutter": "clamp(1.25rem, 4vw, 4rem)"
  },
  "motion": {
    "policy": "cinematic",
    "easing": { "standard": "cubic-bezier(0.16, 1, 0.3, 1)", "exit": "cubic-bezier(0.7, 0, 0.84, 0)" },
    "durations": { "fast": "150ms", "base": "300ms", "slow": "600ms", "reveal": "1200ms" },
    "reducedMotion": "reduce",
    "smoothScroll": true,
    "ambient": { "cursorGlow": false, "noiseOverlay": { "enabled": true, "opacity": 0.03 } },
    "bannedModules": ["GradientStrokeText", "MeshGradient"]
  },
  "voice": {
    "tone": ["confident", "understated"],
    "adjectives": ["heritage", "boutique", "considered"],
    "bannedPhrases": ["game-changer", "elevate", "synergy"],
    "writingStyle": "Plain, specific product language. Short sentences. No hype."
  },
  "imagery": {
    "style": "editorial",
    "formulas": {
      "image": "Shot on {camera}, {lens}, {scene}, {lighting}, {grade}, {avoid}",
      "video": "Slow {motion}: {subject}. {lighting}. {cameraMove}. Cinematic, no text, no watermarks."
    },
    "subjects": ["manicured golf course at dusk", "heritage clubhouse interiors"],
    "lighting": ["golden hour", "soft overcast"],
    "cameras": ["Hasselblad X2D"],
    "lenses": ["55mm f/2.5"],
    "grade": "warm dusk, muted greens",
    "avoid": ["no text", "no watermarks", "no stock feel"],
    "colorTemperature": "warm"
  }
}
